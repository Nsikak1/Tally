<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext HTTP is blocked everywhere EXCEPT the two hosts below.
  Keep this list in sync with CleartextPolicy.ALLOWED_HOSTS in
  data/settings/ServerConfig.kt. If the server IP ever changes, edit BOTH.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.1.117</domain>
        <domain includeSubdomains="false">school.local</domain>
    </domain-config>
</network-security-config>
